# ================================================================================
# BACKEND MAIN CONFIGURATION - TEMPLATE
# ================================================================================
# Copy this to backend/.env and fill in your Binance API keys
# NEVER commit backend/.env with real keys to Git - use GitHub Secrets instead
# ================================================================================

# ==================== API KEYS (REQUIRED) ====================
# Get these from https://www.binance.com/en/account/api-management
BINANCE_SPOT_API_KEY=your_spot_api_key_here
BINANCE_SPOT_API_SECRET=your_spot_api_secret_here
BINANCE_FUTURES_API_KEY=your_futures_api_key_here
BINANCE_FUTURES_API_SECRET=your_futures_api_secret_here

# ==================== BOT CORE CONFIGURATION ====================
BOT_PAPER_MODE=true
BOT_TIMEFRAME=5m
BOT_LOOP_SECONDS=30
BOT_SYMBOLS_PER_TICK=2
# ONLY 5 SYMBOLS: BTC, ETH, XRP, SOL, BNB
BOT_ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT,XRPUSDT,SOLUSDT,BNBUSDT

# ==================== DASHBOARD ====================
BOT_ENABLE_WEB_DASHBOARD=true
BOT_DASHBOARD_HOST=0.0.0.0
BOT_DASHBOARD_PORT=5000
BOT_DASHBOARD_CORS_ORIGIN=*
BOT_STATE_DB_PATH=out/bot_state.sqlite3
BOT_SOCKETIO_ASYNC_MODE=threading

# ==================== STRATEGY MODULES (ALL ENABLED BY DEFAULT) ====================
# All methods enabled here - profiles override RISK parameters, not methods
BOT_ENABLE_M4=true                   # Low-Volatility Mean Reversion
BOT_ENABLE_M5=true                   # VWAP + Volume Profile Levels
BOT_ENABLE_M6=true                   # Multi-Timeframe Divergence

# ==================== MULTI-TIMEFRAME CONFIRMATION ====================
BOT_ENABLE_MTF_CONFIRMATION=true
BOT_MTF_CONFIRM_TIMEFRAMES=15m

# ==================== MODULE PERFORMANCE SCORECARD ====================
BOT_ENABLE_MODULE_SCORECARD=true
BOT_MODULE_PERF_LOOKBACK=10
BOT_MODULE_PERF_MIN_TRADES=4
BOT_MODULE_PERF_MIN_WIN_RATE=0.30
BOT_MODULE_PERF_DISABLE_MINUTES=180

# ==================== RISK MANAGEMENT (DEFAULT) ====================
# These are default values. Profile .env files override these.
BOT_START_EQUITY=50
BOT_RISK_PER_TRADE_PCT=0.0075
BOT_MAX_DAILY_LOSS_PCT=0.025
BOT_MAX_WEEKLY_LOSS_PCT=0.06
BOT_MAX_TRADES_PER_DAY=5
BOT_MAX_TRADES_PER_SYMBOL_DAY=2
BOT_COOLDOWN_MINUTES=15
BOT_ENABLE_LEVERAGE_2X=false
BOT_M4_RISK_MULTIPLIER=0.5

# ==================== DRAWDOWN SCALING ====================
BOT_ENABLE_DRAWDOWN_SCALING=true
BOT_DRAWDOWN_SCALE_THRESHOLD_PCT=0.01
BOT_DRAWDOWN_SCALE_FACTOR=0.75

# ==================== EXECUTION & POSITION MANAGEMENT ====================
BOT_SPOT_FEE_BPS=10
BOT_PERP_FEE_BPS=4
BOT_SLIPPAGE_BPS=8
BOT_SLIPPAGE_LIMIT_PCT=0.10
BOT_ENABLE_PARTIAL_TP=true
BOT_PARTIAL_TP_FRACTION=0.5
BOT_ENABLE_TRAILING_STOP=true
BOT_TRAILING_ATR_MULTIPLIER=1.2

# ==================== DATA ====================
BOT_DATA_TIMEOUT_SECONDS=6
BOT_DATA_RETRIES=1
BOT_DATA_RETRY_BACKOFF_SECONDS=0.4
BOT_USE_MAINNET_DATA_FALLBACK=true

# ==================== PROFILE OVERRIDES ====================
# See profiles/conservative.env and profiles/aggressive.env for profile-specific settings
# Profiles override: risk parameters, trade limits, position management
# Profiles DO NOT override: strategy modules (all stay enabled)
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=

# Alerts
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USER=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
