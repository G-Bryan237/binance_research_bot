# Complete .env.example with ALL Features (May 2026)
# Use this as a reference for all available configuration options

# ==================== API CONFIGURATION ====================
BINANCE_SPOT_API_KEY=your_spot_api_key
BINANCE_SPOT_API_SECRET=your_spot_api_secret
BINANCE_FUTURES_API_KEY=your_futures_api_key
BINANCE_FUTURES_API_SECRET=your_futures_api_secret

BOT_DATA_TIMEOUT_SECONDS=6
BOT_DATA_RETRIES=1
BOT_DATA_RETRY_BACKOFF_SECONDS=0.6
BOT_USE_MAINNET_DATA_FALLBACK=true

# ==================== BOT CORE CONFIGURATION ====================
BOT_PAPER_MODE=true
BOT_TIMEFRAME=5m
BOT_LOOP_SECONDS=30
BOT_SYMBOLS_PER_TICK=4
BOT_ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,ADAUSDT,XRPUSDT,DOTUSDT,AVAXUSDT,LINKUSDT,ATOMUSDT,NEARUSDT,LTCUSDT
BOT_ENABLE_WEB_DASHBOARD=true
BOT_DASHBOARD_HOST=0.0.0.0
BOT_DASHBOARD_PORT=5000
BOT_DASHBOARD_CORS_ORIGIN=*
BOT_STATE_DB_PATH=out/bot_state.sqlite3
BOT_SOCKETIO_ASYNC_MODE=threading

# ==================== STRATEGY MODULES ====================
BOT_ENABLE_M4=true
BOT_ENABLE_M5=true                   # VWAP + Volume Profile institutional levels
BOT_ENABLE_M6=true                   # Multi-timeframe divergence overlay

# ==================== MULTI-TIMEFRAME CONFIRMATION ====================
BOT_ENABLE_MTF_CONFIRMATION=true
BOT_MTF_CONFIRM_TIMEFRAMES=15m

# ==================== MODULE PERFORMANCE SCORECARD ====================
BOT_ENABLE_MODULE_SCORECARD=true
BOT_MODULE_PERF_LOOKBACK=10
BOT_MODULE_PERF_MIN_TRADES=4
BOT_MODULE_PERF_MIN_WIN_RATE=0.30
BOT_MODULE_PERF_DISABLE_MINUTES=180

# ==================== RISK MANAGEMENT ====================
BOT_START_EQUITY=50
BOT_RISK_PER_TRADE_PCT=0.0075
BOT_MAX_DAILY_LOSS_PCT=0.025
BOT_MAX_WEEKLY_LOSS_PCT=0.06
BOT_MAX_TRADES_PER_DAY=5
BOT_MAX_TRADES_PER_SYMBOL_DAY=2
BOT_COOLDOWN_MINUTES=15
BOT_ENABLE_LEVERAGE_2X=false
BOT_M4_RISK_MULTIPLIER=0.5

# ==================== DRAWDOWN-AWARE SCALING (NEW - May 2026) ====================
# Scale position sizes down as drawdown increases during losing streaks
BOT_ENABLE_DRAWDOWN_SCALING=true
BOT_DRAWDOWN_SCALE_THRESHOLD_PCT=0.01
BOT_DRAWDOWN_SCALE_FACTOR=0.75

# ==================== EXECUTION & PARTIAL TP ====================
BOT_ENABLE_PARTIAL_TP=true
BOT_PARTIAL_TP_FRACTION=0.5
BOT_ENABLE_TRAILING_STOP=true
BOT_TRAILING_ATR_MULTIPLIER=1.2

BOT_SPOT_FEE_BPS=10
BOT_PERP_FEE_BPS=4
BOT_SLIPPAGE_BPS=8
BOT_SLIPPAGE_LIMIT_PCT=0.10
BOT_SPREAD_LIMIT_SPOT_PCT=0.08
BOT_SPREAD_LIMIT_PERP_PCT=0.10

# ==================== ADVANCED INDICATORS (NEW - May 2026) ====================
BOT_ENABLE_MACD=true
BOT_MACD_FAST=12
BOT_MACD_SLOW=26
BOT_MACD_SIGNAL=9

BOT_ENABLE_BOLLINGER_BANDS=true
BOT_BB_LENGTH=20
BOT_BB_STD_DEV=2.0

BOT_ENABLE_STOCH_RSI=true
BOT_STOCH_RSI_LENGTH=14
BOT_STOCH_RSI_K=3
BOT_STOCH_RSI_D=3

BOT_ENABLE_OBV=true

BOT_ENABLE_ICHIMOKU=false
BOT_ICHIMOKU_CONVERSION=9
BOT_ICHIMOKU_BASE=26
BOT_ICHIMOKU_SPAN_B=52
BOT_ICHIMOKU_DISPLACEMENT=26

# ==================== DIVERGENCE DETECTION (NEW - May 2026) ====================
BOT_ENABLE_DIVERGENCE_DETECTION=true
BOT_DIVERGENCE_LOOKBACK=20
BOT_DIVERGENCE_SWING_WINDOW=3
BOT_ENABLE_MACD_DIVERGENCE=true

# ==================== EXIT SIGNAL IMPROVEMENTS (NEW - May 2026) ====================
BOT_ENABLE_REVERSAL_EXITS=true
BOT_ENABLE_CANDLE_PATTERN_EXITS=true

# ==================== FUNDING RATE TREND ANALYSIS (NEW - May 2026) ====================
BOT_ENABLE_FUNDING_TREND_ANALYSIS=true
BOT_FUNDING_TREND_WINDOW=24
BOT_FUNDING_TREND_SLOPE_BPS_PER_HOUR=4
BOT_FUNDING_SPIKE_ALERT_BPS=50

# ==================== DEPTH-AWARE MICROSTRUCTURE (NEW - May 2026) ====================
# WARNING: Enabling depth analysis increases API usage by ~1-2 calls per symbol
# Only enable after confirming API rate limits are sufficient
BOT_ENABLE_DEPTH_ANALYSIS=false
BOT_ORDERBOOK_DEPTH_LIMIT=20
BOT_IMBALANCE_THRESHOLD=1.3
BOT_ORDERBOOK_WALL_MULTIPLIER=3.5
BOT_ORDERBOOK_WALL_RANGE_BPS=12
BOT_MIN_ORDERBOOK_LEVELS=5
BOT_MIN_ORDERBOOK_NOTIONAL_SPOT=50000
BOT_MIN_ORDERBOOK_NOTIONAL_PERP=100000

# ==================== DYNAMIC SLIPPAGE MODEL (NEW - May 2026) ====================
# Requires BOT_ENABLE_DEPTH_ANALYSIS=true to function
# Dynamically adjusts slippage based on orderbook imbalance
BOT_DYNAMIC_SLIPPAGE_ENABLED=false
BOT_SLIPPAGE_VOLATILITY_MULTIPLIER=0.6
BOT_SLIPPAGE_SPREAD_MULTIPLIER=0.5
BOT_LATENCY_BPS=1.5

# ==================== VWAP & VOLUME PROFILE (NEW - May 2026) ====================
BOT_ENABLE_VWAP=true
BOT_VWAP_USE_CURRENT_SESSION=false
BOT_VWAP_LOOKBACK=60

BOT_ENABLE_VOLUME_PROFILE=false
BOT_VOLUME_PROFILE_BINS=50
BOT_VOLUME_PROFILE_LOOKBACK=200
BOT_VOLUME_PROFILE_VALUE_AREA_PCT=0.7

# ==================== SMART LIMIT ORDERS (NEW - May 2026) ====================
BOT_ENABLE_LIMIT_ORDERS=false
BOT_LIMIT_ORDER_OFFSET_BPS=5
BOT_LIMIT_ORDER_TIMEOUT_SECONDS=10

# ==================== ALERTS CONFIGURATION ====================
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USER=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
