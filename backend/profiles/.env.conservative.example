# ================================================================================
# CONSERVATIVE PROFILE - OVERRIDES TEMPLATE
# ================================================================================
# Copy to backend/profiles/conservative.env
# This file ONLY overrides risk parameters, not strategy modules
# ================================================================================

BOT_PROFILE_ID=conservative
BOT_PROFILE_NAME=Conservative Profile
BOT_DASHBOARD_PORT=5001
BOT_STATE_DB_PATH=out/conservative/bot_state.sqlite3
BOT_ENABLE_REPORTING=true
BOT_REPORT_OUTPUT_DIR=reports

# ==================== RISK MANAGEMENT (CONSERVATIVE OVERRIDES) ====================
BOT_RISK_PER_TRADE_PCT=0.005         # 0.5% per trade (vs 0.75% default)
BOT_MAX_DAILY_LOSS_PCT=0.015         # 1.5% daily max (vs 2.5% default)
BOT_MAX_WEEKLY_LOSS_PCT=0.04         # 4% weekly max (vs 6% default)
BOT_MAX_TRADES_PER_DAY=3             # 3 trades/day (vs 5 default)
BOT_MAX_TRADES_PER_SYMBOL_DAY=1      # 1 trade per symbol/day (vs 2 default)
BOT_COOLDOWN_MINUTES=30              # 30 min cooldown (vs 15 default)
BOT_ENABLE_LEVERAGE_2X=false         # No leverage
BOT_M4_RISK_MULTIPLIER=0.4           # Lower M4 risk

# ==================== DRAWDOWN SCALING (MORE AGGRESSIVE) ====================
BOT_DRAWDOWN_SCALE_THRESHOLD_PCT=0.008
BOT_DRAWDOWN_SCALE_FACTOR=0.6

# ==================== EXECUTION FILTERS (STRICTER) ====================
BOT_SLIPPAGE_BPS=6
BOT_SLIPPAGE_LIMIT_PCT=0.06
BOT_SPREAD_LIMIT_SPOT_PCT=0.06
BOT_SPREAD_LIMIT_PERP_PCT=0.08

# ==================== POSITION MANAGEMENT (MORE CONSERVATIVE) ====================
BOT_PARTIAL_TP_FRACTION=0.6
BOT_TP_RR_LEVELS=1.0,1.5,2.0
BOT_TP_CLOSE_FRACTIONS=0.35,0.35,0.3
BOT_TRAILING_ATR_MULTIPLIER=1.0
BOT_TRAILING_ACTIVATION_RR=1.0
BOT_MAX_HOLD_MINUTES=240
