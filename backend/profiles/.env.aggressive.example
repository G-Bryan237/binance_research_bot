# ================================================================================
# AGGRESSIVE PROFILE - OVERRIDES TEMPLATE
# ================================================================================
# Copy to backend/profiles/aggressive.env
# This file ONLY overrides risk parameters, not strategy modules
# ================================================================================

BOT_PROFILE_ID=aggressive
BOT_PROFILE_NAME=Aggressive Profile
BOT_DASHBOARD_PORT=5002
BOT_STATE_DB_PATH=out/aggressive/bot_state.sqlite3
BOT_ENABLE_REPORTING=true
BOT_REPORT_OUTPUT_DIR=reports

# ==================== RISK MANAGEMENT (AGGRESSIVE OVERRIDES) ====================
BOT_RISK_PER_TRADE_PCT=0.012         # 1.2% per trade (vs 0.75% default)
BOT_MAX_DAILY_LOSS_PCT=0.04          # 4% daily max (vs 2.5% default)
BOT_MAX_WEEKLY_LOSS_PCT=0.10         # 10% weekly max (vs 6% default)
BOT_MAX_TRADES_PER_DAY=8             # 8 trades/day (vs 5 default)
BOT_MAX_TRADES_PER_SYMBOL_DAY=3      # 3 trades per symbol/day (vs 2 default)
BOT_COOLDOWN_MINUTES=10              # 10 min cooldown (vs 15 default)
BOT_ENABLE_LEVERAGE_2X=true          # Leverage enabled
BOT_M4_RISK_MULTIPLIER=0.7           # Higher M4 risk

# ==================== DRAWDOWN SCALING (LESS AGGRESSIVE) ====================
BOT_DRAWDOWN_SCALE_THRESHOLD_PCT=0.015
BOT_DRAWDOWN_SCALE_FACTOR=0.85

# ==================== EXECUTION FILTERS (LOOSER) ====================
BOT_SLIPPAGE_BPS=10
BOT_SLIPPAGE_LIMIT_PCT=0.15
BOT_SPREAD_LIMIT_SPOT_PCT=0.12
BOT_SPREAD_LIMIT_PERP_PCT=0.15

# ==================== POSITION MANAGEMENT (MORE AGGRESSIVE) ====================
BOT_PARTIAL_TP_FRACTION=0.4
BOT_TP_RR_LEVELS=1.2,2.0,3.0
BOT_TP_CLOSE_FRACTIONS=0.25,0.35,0.4
BOT_TRAILING_ATR_MULTIPLIER=1.5
BOT_TRAILING_ACTIVATION_RR=0.5
BOT_MAX_HOLD_MINUTES=480
