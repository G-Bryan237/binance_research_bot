BOT_PROFILE_ID=aggressive
BOT_PROFILE_NAME=Aggressive Profile
BOT_DASHBOARD_PORT=5002
BOT_STATE_DB_PATH=out/aggressive/bot_state.sqlite3
BOT_ENABLE_REPORTING=true
BOT_REPORT_OUTPUT_DIR=reports
# =============================================================================
# AGGRESSIVE PROFILE - Maximum Edge Capture
# =============================================================================
# Use this profile when:
# - System is proven profitable in backtest + paper
# - High-conviction market conditions (clear trends/breakouts)
# - Small account size where you can afford higher relative risk
# - Seeking higher returns with acceptance of higher drawdowns
#
# Characteristics:
# - Higher risk per trade
# - All modules active (M1-M6)
# - Looser filters (more trade opportunities)
# - Higher daily/weekly loss limits
# - Leverage enabled for perps
#
# WARNING: Only use after extensive paper trading validation.
# =============================================================================

# ==================== STRATEGY MODULES (ALL ACTIVE) ====================
BOT_ENABLE_M4=true
BOT_ENABLE_M5=true                   # VWAP/Volume Profile overlay
BOT_ENABLE_M6=true                   # MTF Divergence overlay

# ==================== RISK MANAGEMENT (AGGRESSIVE) ====================
BOT_START_EQUITY=50
BOT_RISK_PER_TRADE_PCT=0.012         # 1.2% per trade (higher than default 0.75%)
BOT_MAX_DAILY_LOSS_PCT=0.04          # 4% daily max (looser than default 2.5%)
BOT_MAX_WEEKLY_LOSS_PCT=0.10         # 10% weekly max (looser than default 6%)
BOT_MAX_TRADES_PER_DAY=8             # Max 8 trades/day
BOT_MAX_TRADES_PER_SYMBOL_DAY=3      # Max 3 trades per symbol/day
BOT_COOLDOWN_MINUTES=10              # 10 min cooldown (faster)
BOT_ENABLE_LEVERAGE_2X=true          # 2x leverage enabled for perps
BOT_M4_RISK_MULTIPLIER=0.7           # Higher M4 risk allocation

# Drawdown scaling (less aggressive scaling)
BOT_ENABLE_DRAWDOWN_SCALING=true
BOT_DRAWDOWN_SCALE_THRESHOLD_PCT=0.015
BOT_DRAWDOWN_SCALE_FACTOR=0.85

# ==================== EXECUTION (LOOSER FILTERS) ====================
BOT_SPOT_FEE_BPS=10
BOT_PERP_FEE_BPS=4
BOT_SLIPPAGE_BPS=10                  # Accept higher slippage
BOT_SLIPPAGE_LIMIT_PCT=0.15          # Allow up to 0.15% slippage
BOT_SPREAD_LIMIT_SPOT_PCT=0.12       # Allow wider spreads
BOT_SPREAD_LIMIT_PERP_PCT=0.15

# Partial TP and trailing
BOT_ENABLE_PARTIAL_TP=true
BOT_PARTIAL_TP_FRACTION=0.4          # Take 40% at first target (let winners run)
BOT_TP_RR_LEVELS=1.2,2.0,3.0         # More aggressive TP levels
BOT_TP_CLOSE_FRACTIONS=0.25,0.35,0.4
BOT_ENABLE_TRAILING_STOP=true
BOT_ENABLE_TRAILING_ON_FULL_POSITION=true
BOT_TRAILING_ACTIVATION_RR=0.5       # Activate trailing earlier
BOT_TRAILING_ATR_MULTIPLIER=1.5      # Wider trailing stop

# Time-based exit
BOT_ENABLE_TIME_EXIT=true
BOT_MAX_HOLD_MINUTES=480             # 8 hour max hold (longer)

# ==================== MULTI-TIMEFRAME CONFIRMATION ====================
BOT_ENABLE_MTF_CONFIRMATION=true
BOT_MTF_CONFIRM_TIMEFRAMES=15m       # Single HTF confirmation (faster signals)

# ==================== MODULE PERFORMANCE SCORECARD ====================
BOT_ENABLE_MODULE_SCORECARD=true
BOT_MODULE_PERF_LOOKBACK=12          # Longer lookback
BOT_MODULE_PERF_MIN_TRADES=5
BOT_MODULE_PERF_MIN_WIN_RATE=0.25    # Lower minimum (more lenient)
BOT_MODULE_PERF_DISABLE_MINUTES=120  # 2 hour disable (shorter)

# ==================== INDICATORS (ALL ACTIVE) ====================
BOT_ENABLE_MACD=true
BOT_MACD_FAST=12
BOT_MACD_SLOW=26
BOT_MACD_SIGNAL=9

BOT_ENABLE_BOLLINGER_BANDS=true
BOT_BB_LENGTH=20
BOT_BB_STD_DEV=2.0

BOT_ENABLE_STOCH_RSI=true
BOT_STOCH_RSI_LENGTH=14
BOT_STOCH_RSI_K=3
BOT_STOCH_RSI_D=3

BOT_ENABLE_OBV=true
BOT_ENABLE_ICHIMOKU=true             # Ichimoku enabled for trend confirmation

BOT_ENABLE_DIVERGENCE_DETECTION=true
BOT_DIVERGENCE_LOOKBACK=25           # Longer divergence lookback
BOT_DIVERGENCE_SWING_WINDOW=4
BOT_ENABLE_MACD_DIVERGENCE=true

# VWAP/Volume Profile (required for M5)
BOT_ENABLE_VWAP=true
BOT_VWAP_USE_CURRENT_SESSION=true    # Session-based VWAP
BOT_VWAP_LOOKBACK=120                # Longer lookback

BOT_ENABLE_VOLUME_PROFILE=true       # Required for M5
BOT_VOLUME_PROFILE_BINS=60
BOT_VOLUME_PROFILE_LOOKBACK=300
BOT_VOLUME_PROFILE_VALUE_AREA_PCT=0.7

# ==================== DEPTH ANALYSIS (OPTIONAL) ====================
BOT_ENABLE_DEPTH_ANALYSIS=false      # Enable if you want orderbook analysis
BOT_ENABLE_ORDERBOOK_ANALYSIS=false
BOT_DYNAMIC_SLIPPAGE_ENABLED=false

# ==================== SYMBOLS (EXPANDED LIST) ====================
BOT_ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,ADAUSDT,XRPUSDT,AVAXUSDT,LINKUSDT

# ==================== BOT CORE ====================
BOT_PAPER_MODE=true                  # ALWAYS start with paper mode
BOT_TIMEFRAME=5m
BOT_LOOP_SECONDS=25                  # Faster loop
BOT_SYMBOLS_PER_TICK=4               # Process more symbols per tick
