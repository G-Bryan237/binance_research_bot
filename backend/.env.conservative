BOT_PROFILE_ID=conservative
BOT_PROFILE_NAME=Conservative Profile
BOT_DASHBOARD_PORT=5001
BOT_STATE_DB_PATH=out/conservative/bot_state.sqlite3
BOT_ENABLE_REPORTING=true
BOT_REPORT_OUTPUT_DIR=reports
# =============================================================================
# CONSERVATIVE PROFILE - Institutional Style
# =============================================================================
# Use this profile when:
# - Learning the system / paper trading
# - Uncertain market conditions
# - After drawdown or losing streak
# - Prioritizing capital preservation over returns
#
# Characteristics:
# - Lower risk per trade
# - Stricter filters (spread, slippage, volume)
# - Fewer modules active (M5/M6 off to reduce complexity)
# - Tighter daily/weekly loss limits
# - More cooldown between trades
# =============================================================================

# ==================== STRATEGY MODULES ====================
# Only core regime-mapped modules active
BOT_ENABLE_M4=false
BOT_ENABLE_M5=false
BOT_ENABLE_M6=false

# ==================== RISK MANAGEMENT (CONSERVATIVE) ====================
BOT_START_EQUITY=50
BOT_RISK_PER_TRADE_PCT=0.005         # 0.5% per trade (lower than default 0.75%)
BOT_MAX_DAILY_LOSS_PCT=0.015         # 1.5% daily max (tighter than default 2.5%)
BOT_MAX_WEEKLY_LOSS_PCT=0.04         # 4% weekly max (tighter than default 6%)
BOT_MAX_TRADES_PER_DAY=3             # Max 3 trades/day (fewer than default 5)
BOT_MAX_TRADES_PER_SYMBOL_DAY=1      # Max 1 trade per symbol/day
BOT_COOLDOWN_MINUTES=30              # 30 min cooldown (longer than default 15)
BOT_ENABLE_LEVERAGE_2X=false
BOT_M4_RISK_MULTIPLIER=0.4           # Even lower M4 risk if enabled later

# Drawdown scaling (aggressive scaling down on losses)
BOT_ENABLE_DRAWDOWN_SCALING=true
BOT_DRAWDOWN_SCALE_THRESHOLD_PCT=0.008
BOT_DRAWDOWN_SCALE_FACTOR=0.6

# ==================== EXECUTION (STRICT FILTERS) ====================
BOT_SPOT_FEE_BPS=10
BOT_PERP_FEE_BPS=4
BOT_SLIPPAGE_BPS=6                   # Tighter slippage assumption
BOT_SLIPPAGE_LIMIT_PCT=0.06          # Reject trades with >0.06% slippage
BOT_SPREAD_LIMIT_SPOT_PCT=0.05       # Reject if spread >0.05%
BOT_SPREAD_LIMIT_PERP_PCT=0.06

# Partial TP and trailing
BOT_ENABLE_PARTIAL_TP=true
BOT_PARTIAL_TP_FRACTION=0.6          # Take 60% off at first target
BOT_ENABLE_TRAILING_STOP=true
BOT_TRAILING_ATR_MULTIPLIER=1.0      # Tighter trailing stop

# Time-based exit
BOT_ENABLE_TIME_EXIT=true
BOT_MAX_HOLD_MINUTES=240             # 4 hour max hold (shorter)

# ==================== MULTI-TIMEFRAME CONFIRMATION (REQUIRED) ====================
BOT_ENABLE_MTF_CONFIRMATION=true
BOT_MTF_CONFIRM_TIMEFRAMES=15m,1h    # Require both 15m and 1h alignment

# ==================== MODULE PERFORMANCE SCORECARD (STRICT) ====================
BOT_ENABLE_MODULE_SCORECARD=true
BOT_MODULE_PERF_LOOKBACK=8           # Shorter lookback
BOT_MODULE_PERF_MIN_TRADES=3
BOT_MODULE_PERF_MIN_WIN_RATE=0.35    # Higher minimum win rate required
BOT_MODULE_PERF_DISABLE_MINUTES=300  # 5 hour disable for underperformers

# ==================== INDICATORS (MINIMAL) ====================
BOT_ENABLE_MACD=true
BOT_ENABLE_BOLLINGER_BANDS=true
BOT_ENABLE_STOCH_RSI=false           # Off to reduce noise
BOT_ENABLE_OBV=true
BOT_ENABLE_ICHIMOKU=false
BOT_ENABLE_DIVERGENCE_DETECTION=true
BOT_ENABLE_MACD_DIVERGENCE=true

# VWAP/Volume Profile (for M5 if enabled later)
BOT_ENABLE_VWAP=true
BOT_ENABLE_VOLUME_PROFILE=false

# ==================== SYMBOLS (MAJORS ONLY) ====================
BOT_ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# ==================== BOT CORE ====================
BOT_PAPER_MODE=true
BOT_TIMEFRAME=5m
BOT_LOOP_SECONDS=45                  # Slower loop
BOT_SYMBOLS_PER_TICK=2               # Process fewer symbols per tick
